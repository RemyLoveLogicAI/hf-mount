# Re-trigger qlty CI after addressing review feedback on PR #6.

[Unit]
Description=hf-mount {{ backend }} mount for {{ repo }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ user }}
Group={{ group }}
Environment=HOME={{ state_dir }}
Environment=HF_TOKEN_FILE={{ token_dir }}/hf-token
ExecStartPre=/bin/mkdir -p {{ mount_point }}
ExecStartPre=/bin/chown {{ user }}:{{ group }} {{ mount_point }}
ExecStart={{ install_dir }}/hf-mount-{{ backend }} {{ source_type }} {{ repo }} {{ mount_point }} {{ options }}
ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=180
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
